{
  "model": "claude-fable-5-1",
  "effortLevel": "max",
  "theme": "light",
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline/statusline.js\"",
    "padding": 0
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/harness-reminder.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/ascii-punctuation.js\"",
            "statusMessage": "Проверка ASCII-пунктуации"
          }
        ]
      }
    ]
  }
}
