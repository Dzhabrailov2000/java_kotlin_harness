{
  "model": "claude-opus-4-8",
  "theme": "light",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/harness-reminder.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/ascii-punctuation.js\"",
            "statusMessage": "Проверка ASCII-пунктуации"
          }
        ]
      }
    ]
  }
}
